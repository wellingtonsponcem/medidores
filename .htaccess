# Defesa em profundidade.
#
# Em produção o medidores.env mora um nível acima do public_html, então o
# servidor web nem o enxerga. Este arquivo é a rede de segurança para o caso de
# alguém (ou um deploy) deixar cair um arquivo de variáveis dentro da webroot —
# já acontece, e o preço é entregar a chave do Gemini num GET direto.
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

# O banco local também não deve ser servido: tem a senha do MySQL.
<FilesMatch "^db_config\.php$">
    Require all denied
</FilesMatch>

# O coletor da Tuya grava no banco e imprime o progresso: só entra por include
# (sync.php com admin logado, ou o bot). Chamado direto pela URL, ficava aberto.
<FilesMatch "^coleta_tuya\.(php|js)$">
    Require all denied
</FilesMatch>

# Ninguém precisa ler os testes nem o histórico pelo navegador.
<FilesMatch "^(HISTORICO\.md|README\.md)$">
    Require all denied
</FilesMatch>

# Variáveis sem o ponto: o "env" antigo entregava a chave do Gemini num GET,
# porque o bloqueio acima só pega nomes começando com ".env".
<FilesMatch "^(env|medidores\.env)$">
    Require all denied
</FilesMatch>

# Scripts de manutenção que rodam no banco a cada GET (migração, recriação de
# views) ou despejam dados dele. Só fazem sentido rodados de propósito.
<FilesMatch "^(debug|migration|fix-view|fix-energia-views|scratch_inspect_db)\.php$">
    Require all denied
</FilesMatch>

# Saídas de experimento, scripts e documentos do repositório: não são do site.
<FilesMatch "(^(api_output|energy_output|models)\.json|^test.*\.js|\.(py|sh|sql|md))$">
    Require all denied
</FilesMatch>

Options -Indexes
