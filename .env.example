# Exemplo de configuração do D-Meter.
#
# Copie para medidores.env (fora do public_html, um nível acima dele) e preencha.
# Em produção o caminho é /home/u306254544/medidores.env — assim o servidor web
# não consegue servir o arquivo num GET direto.
#
# NUNCA preencha este arquivo com valor de verdade. Ele é versionado de propósito,
# para quem for novo no projeto saber quais chaves existem e onde pegá-las.

# --- Gemini (leitura por foto da fatura e dos medidores) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Tuya (coleta automática do queímetro da Av. Brasil) ---
# https://developer.tuya.com/
TUYA_CLIENT_ID=
TUYA_CLIENT_SECRET=
TUYA_DEVICE_ID=

# --- Supabase (banco de dados do painel) ---
# https://supabase.com/dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_KEY=

# --- Bot do Telegram (preenchidos pelo scripts/telegram-setup.mjs) ---
# Token do BotFather. Em produção ele vive em app_secrets, não aqui — este valor
# é só o fallback para o setup inicial e para desenvolvimento local.
TELEGRAM_BOT_TOKEN=

# Assinatura do webhook. Gerada pelo telegram-setup.mjs (comando `set`) e gravada
# no banco; sem ela o webhook recusa toda requisição, inclusive as válidas.
TELEGRAM_SECRET_TOKEN=

# Allowlist de quem pode falar com o bot, separada por vírgula.
# SEM ESTE VALOR NINGUÉM CONSEGUE USAR O BOT: a checagem falha fechada.
TELEGRAM_ALLOWED_USER_IDS=

# --- Opcionais ---
# Caminho alternativo para o arquivo de variáveis.
# MEDIDORES_ENV_PATH=
# URL pública do painel, que aparece no fim das mensagens.
# MEDIDORES_URL=https://wedistinto.com/medidores/
